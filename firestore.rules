rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && profile().data.active == true; }
    function admin() { return activeUser() && profile().data.role == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      // Staff may update only their own display name. Roles, active status, and account access stay admin-controlled.
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
    }

    match /counterRecords/{recordId} {
      allow read: if admin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId','cashier','date','status','data','updatedAt'])
        && request.resource.data.status in ['Draft','Submitted'];
      allow update: if admin() || (activeUser()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'Draft'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['Draft','Submitted']);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
